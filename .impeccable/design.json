      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:8px;}.ds-nav button{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;border:1px solid var(--line,#d6dddf);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#20292e);padding:8px 13px;font-weight:600;cursor:pointer;}.ds-nav button:hover{background:var(--subtle,#f7f8f8);border-color:var(--muted,#57656c);}.ds-nav button:active{transform:translateY(1px);}.ds-nav button:focus-visible{outline:3px solid var(--focus,#247b9a);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Contemporary transport reference manual",
    "overview": "Neutral surfaces, measured divisions, aligned quantity tables, and a keyed geometric diagram make the inherited calculation state inspectable. Orange identifies the main action and outflow, while subdued rules organize a dense working interface.\n\nThis is a code-led, local HTML/CSS/JavaScript tool. System UI typography and light or dark colors follow the operating system; no external fonts or raster assets form part of the interface. The documented visual scope is Modernize Source Code/JB-1, not a brand system for unrelated utilities.",
    "keyCharacteristics": [
      "Inputs alongside a larger diagram and quantity workspace on desktop.",
      "Aligned tabular numbers with explicit units.",
      "Flat bordered panels and restrained action color.",
      "OS-matched appearance and a separate printable report."
    ],
    "rules": [
      {
        "name": "The State Before Quantity Rule",
        "body": "Invalid current inputs replace the current diagram and quantities with an error; invalid boxes also suppress project totals and disable Save and Print.",
        "section": "colors"
      },
      {
        "name": "The Aligned Numbers Rule",
        "body": "Use tabular numerals for numeric fields, quantities, and tables; keep units adjacent to their values or column headings.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate regions with surface tone and thin borders; the built interface uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve explicit units and diagram side numbers.",
      "Do follow the operating system appearance with the paired light and dark colors.",
      "Do keep invalid calculation feedback visible and suppress invalid quantities.",
      "Do keep project file actions local and report printing available for valid projects."
    ],
    "donts": [
      "Don't present the schematic as a construction drawing.",
      "Don't imply current MDOT compliance or structural adequacy from this legacy reproduction.",
      "Don't introduce remote fonts, hosted dependencies, or shipping raster assets into the offline interface."
    ]
  }
}
