  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Print valid project quantities through the native print flow.",
      "html": "<button class=\"ds-primary\">Print report</button>",
      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;border:1px solid var(--line,#d6dddf);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#20292e);padding:8px 13px;font-weight:600;cursor:pointer;background:var(--accent,#a74613);border-color:var(--accent,#a74613);color:#fff;}.ds-primary:hover{background:var(--accent-hover,#85350c);}.ds-primary:active{transform:translateY(1px);}.ds-primary:focus-visible{outline:3px solid var(--focus,#247b9a);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:default;transform:none;}@media(prefers-color-scheme:dark){.ds-primary{background:var(--accent,#ffb178);border-color:var(--accent,#ffb178);color:#24170f;}.ds-primary:hover{background:var(--accent-hover,#ffc99f);}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Local project and box actions.",
      "html": "<button class=\"ds-secondary\">Save project</button>",
      "css": ".ds-secondary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;border:1px solid var(--line,#d6dddf);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#20292e);padding:8px 13px;font-weight:600;cursor:pointer;}.ds-secondary:hover{background:var(--subtle,#f7f8f8);border-color:var(--muted,#57656c);}.ds-secondary:active{transform:translateY(1px);}.ds-secondary:focus-visible{outline:3px solid var(--focus,#247b9a);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:default;transform:none;}"
    },
    {
      "name": "Numeric field",
      "kind": "input",
      "refersTo": "input",
      "description": "Persistent labels and explicit automatic-height placeholder.",
      "html": "<label class=\"ds-field\">Box height <input type=\"number\" placeholder=\"Use calculated minimum\"></label>",
      "css": ".ds-field{display:grid;gap:5px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;font-size:.83rem;font-weight:600;color:var(--ink,#20292e);}.ds-field input{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;min-width:0;border:1px solid var(--line,#d6dddf);border-radius:5px;padding:8px 9px;background:var(--surface,#fff);color:var(--ink,#20292e);font-variant-numeric:tabular-nums;caret-color:var(--accent,#a74613);}.ds-field input::placeholder{color:var(--muted,#57656c);opacity:1;}.ds-field input:focus-visible{outline:3px solid var(--focus,#247b9a);outline-offset:3px;}.ds-field input:disabled{background:var(--ground,#f3f4f4);color:var(--muted,#57656c);opacity:.7;}.ds-field input[aria-invalid=\"true\"]{border-color:var(--error,#a22424);}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat panel and aligned quantity row.",
      "html": "<section class=\"ds-panel\"><h3>Box quantities</h3><dl><div><dt>Height</dt><dd>3.500 ft</dd></div></dl></section>",
      "css": ".ds-panel{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;background:var(--surface,#fff);color:var(--ink,#20292e);border:1px solid var(--line,#d6dddf);border-radius:10px;padding:22px;}.ds-panel h3{margin:0;font-size:1rem;font-weight:650;}.ds-panel dl{margin:0;}.ds-panel dl div{display:flex;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--line,#d6dddf);}.ds-panel dt{font-size:.84rem;color:var(--muted,#57656c);}.ds-panel dd{margin:0;font-weight:650;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Calculation alert",
      "kind": "custom",
      "refersTo": "error",
      "description": "Replaces invalid current quantities with actionable text.",
      "html": "<div class=\"ds-error\" role=\"alert\">Correct the inputs to calculate this box.</div>",
      "css": ".ds-error{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:16px;line-height:1.5;border:1px solid var(--error,#a22424);border-radius:6px;color:var(--error,#a22424);background:var(--error-bg,#fff1ef);padding:14px 16px;font-size:.9rem;}"
    },
